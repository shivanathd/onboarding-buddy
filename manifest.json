{
  "display_information": {
    "name": "Onboarding Buddy",
    "description": "Keeps onboarding steps moving. Answer, Advance, Chase, Report.",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "onboarding-buddy",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "reactions:write",
        "chat:write",
        "channels:write"
      ],
      "bot": [
        "app_mentions:read",
        "chat:write",
        "reactions:read",
        "lists:read",
        "lists:write",
        "channels:history",
        "files:read",
        "canvases:read",
        "assistant:write",
        "users:read",
        "mcp:connect"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "reaction_added"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "is_mcp_enabled": false
  },
  "mcp_servers": {
    "onboarding": {
      "url": "https://worker-production-fd77.up.railway.app/mcp",
      "auth_type": "slack_identity_auth"
    }
  }
}
