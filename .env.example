# Copy this to .env and fill it in. .env is gitignored. Never commit it.
# The worker loads .env itself, so `python app.py` is all you need. Real
# environment variables always win over this file, which is how Railway works.

# Bot token. Carries the eight bot scopes listed in the README.
SLACK_BOT_TOKEN=xoxb-...

# App level token with connections:write. This is what Socket Mode needs.
SLACK_APP_TOKEN=xapp-...

# Leave empty to run the worker in template mode. It still starts.
ANTHROPIC_API_KEY=sk-ant-...

# Swap the brain here. One line, no code change.
ANTHROPIC_MODEL=claude-sonnet-5

# The one channel this worker knows. Invite the bot to it.
CHANNEL_ID=C...

# Who gets escalations, and who owns rows with no owner.
MANAGER_ID=U...

# Canvas holding the job description. Optional. Unset means the repo brief.
CANVAS_FILE_ID=F...

# The List that is the worker's memory. Run bootstrap.py once and paste
# its output over the seven lines below.
LIST_ID=

# Step, the primary text column
COL_STEP=

# New hire, a user column
COL_HIRE=

# Owner, a user column
COL_OWNER=

# Due, a date column
COL_DUE=

# Status, a select column with options Open, Done, Escalated
COL_STATUS=

# Thread, a text column holding the chase message ts. This is the loop.
COL_THREAD=

# true shrinks the grace windows and runs chase every 60 seconds.
DEMO_MODE=false

# IANA name. Containers run UTC. Set this or read the loud line in the boot log.
TZ=UTC

# Who the seed assigns. Both optional, both comma separated user ids.
# Leave them empty on a one person workspace and everything lands on you, which
# is normal. Keep SEED_OWNERS as yourself while testing: the worker tags owners,
# and in DEMO_MODE it will tag them every minute.
SEED_HIRES=
SEED_OWNERS=

# Below here is only for running the holdout evals. The worker never reads these.

# A human token, so an eval can react as a person rather than as the bot.
SLACK_USER_TOKEN=

# A channel the bot is NOT in, for the stray mention test.
WRONG_CHANNEL_ID=
